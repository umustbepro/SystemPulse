<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>SystemPulse</AssemblyName>
    <RootNamespace>SystemPulse</RootNamespace>
    <Version>0.8.1</Version>
    <AssemblyVersion>0.8.1.0</AssemblyVersion>
    <FileVersion>0.8.1.0</FileVersion>
    <InformationalVersion>0.8.1</InformationalVersion>
    <GitHubRepository Condition="'$(GitHubRepository)' == ''">umustbepro/SystemPulse</GitHubRepository>
    <ApplicationIcon>Assets\SystemPulse.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitHubRepository" Value="$(GitHubRepository)" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <Resource Include="Assets\SystemPulse.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Vendor\PawnIO\Installer\PawnIO_setup.exe">
      <Link>PawnIO\Installer\PawnIO_setup.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Vendor\PawnIO\Modules\IntelMSR.bin">
      <Link>PawnIO\Modules\IntelMSR.bin</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Vendor\PawnIO\Modules\AMDFamily17.bin">
      <Link>PawnIO\Modules\AMDFamily17.bin</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Vendor\PawnIO\Modules\COPYING.LGPL-2.1">
      <Link>PawnIO\Modules\COPYING.LGPL-2.1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Vendor\PresentMon\PresentMon.exe">
      <Link>PresentMon\PresentMon.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- LibreHardwareMonitor is enabled for motherboard/controller sensors and GPU
       voltage fallback. These storage, RAM-SPD, and Unix assets are not reachable. -->
  <Target Name="RemoveUnusedLibreRuntimeAssets" AfterTargets="ComputeFilesToPublish" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'DiskInfoToolkit' Or
                   '%(Filename)' == 'RAMSPDToolkit-NDD' Or
                   '%(Filename)' == 'BlackSharp.Core' Or
                   '%(Filename)' == 'Mono.Posix.NETStandard' Or
                   '%(Filename)' == 'MonoPosixHelper' Or
                   '%(Filename)' == 'libMonoPosixHelper'" />
    </ItemGroup>
  </Target>
</Project>
