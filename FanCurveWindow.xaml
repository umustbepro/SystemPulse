<Window x:Class="SystemPulse.FanCurveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fan curve" Width="780" Height="760" MinWidth="620" MinHeight="560" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,4"/></Style>
  <Style x:Key="Box" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="9,7"/></Style>
  <Style x:Key="PopupSlider" TargetType="Slider" BasedOn="{StaticResource TuningSlider}"><Setter Property="Height" Value="25"/><Setter Property="Margin" Value="0,3,0,0"/></Style>
 </Window.Resources>
 <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="20,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Configure fan curve" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" HorizontalAlignment="Right" Width="42" Height="42" Style="{DynamicResource IconButton}" Foreground="{DynamicResource TextSecondary}" ToolTip="Close" Click="Cancel_Click"><Viewbox Width="12" Height="12"><Canvas Width="16" Height="16"><Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button></Grid></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,22,26,22">
   <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Hardware}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/><TextBlock Text="{Binding ControlAvailability}" Foreground="{DynamicResource Accent}" Margin="0,4,0,12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="CURVE TYPE" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding CurveTypes}" SelectedItem="{Binding CurveType}" Style="{DynamicResource ThemedComboBox}"/><TextBlock Text="TEMPERATURE SOURCE" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor}" Style="{DynamicResource ThemedComboBox}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="GRAPH POINTS · TEMP:SPEED" Style="{StaticResource Label}"/><TextBox Text="{Binding GraphPoints}" Style="{StaticResource Box}" ToolTip="30:20,40:30,55:50,70:75,85:100"/><TextBlock Text="AVOID SPEED RANGES" Style="{StaticResource Label}"/><TextBox Text="{Binding AvoidRanges}" Style="{StaticResource Box}" ToolTip="48-52,73-76"/></StackPanel>
   </Grid>
   <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"><StackPanel><CheckBox Content="RPM target mode (requires calibration)" IsChecked="{Binding UseRpmMode}" Style="{DynamicResource HistoryToggle}"/><Grid Margin="0,7,0,0"><TextBlock Text="TARGET RPM" Style="{StaticResource Label}" Margin="0"/><TextBlock Text="{Binding TargetRpm, StringFormat={}{0:0} RPM}" HorizontalAlignment="Right"/></Grid><Slider Minimum="0" Maximum="5000" Value="{Binding TargetRpm}" Style="{StaticResource PopupSlider}" ToolTip="Calibration determines the percentage needed to approach this RPM."/></StackPanel></Border>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel>
     <Grid><TextBlock Text="MINIMUM TEMPERATURE" Style="{StaticResource Label}"/><TextBlock Text="{Binding MinimumTemperature, StringFormat={}{0:0}°C}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="20" Maximum="90" Value="{Binding MinimumTemperature}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="MAXIMUM TEMPERATURE" Style="{StaticResource Label}"/><TextBlock Text="{Binding MaximumTemperature, StringFormat={}{0:0}°C}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="40" Maximum="110" Value="{Binding MaximumTemperature}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="MINIMUM SPEED" Style="{StaticResource Label}"/><TextBlock Text="{Binding MinimumPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="0" Maximum="100" Value="{Binding MinimumPercent}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="MAXIMUM SPEED" Style="{StaticResource Label}"/><TextBlock Text="{Binding MaximumPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="0" Maximum="100" Value="{Binding MaximumPercent}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="CURVE OFFSET" Style="{StaticResource Label}"/><TextBlock Text="{Binding OffsetPercent, StringFormat={}{0:+0;-0;0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="-30" Maximum="30" Value="{Binding OffsetPercent}" Style="{StaticResource PopupSlider}"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <Grid><TextBlock Text="START SPEED" Style="{StaticResource Label}"/><TextBlock Text="{Binding StartPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="0" Maximum="100" Value="{Binding StartPercent}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="STOP BELOW" Style="{StaticResource Label}"/><TextBlock Text="{Binding StopPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="0" Maximum="100" Value="{Binding StopPercent}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="STEP UP" Style="{StaticResource Label}"/><TextBlock Text="{Binding StepUpPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="1" Maximum="50" Value="{Binding StepUpPercent}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="STEP DOWN" Style="{StaticResource Label}"/><TextBlock Text="{Binding StepDownPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="1" Maximum="50" Value="{Binding StepDownPercent}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="HYSTERESIS" Style="{StaticResource Label}"/><TextBlock Text="{Binding Hysteresis, StringFormat={}{0:0.0}°C}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="0" Maximum="10" Value="{Binding Hysteresis}" Style="{StaticResource PopupSlider}"/>
     <Grid><TextBlock Text="RESPONSE TIME" Style="{StaticResource Label}"/><TextBlock Text="{Binding ResponseSeconds, StringFormat={}{0:0}s}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><Slider Minimum="0" Maximum="30" Value="{Binding ResponseSeconds}" Style="{StaticResource PopupSlider}"/>
    </StackPanel>
   </Grid>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Style="{DynamicResource SecondaryButton}" Padding="18,8" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Apply curve" Style="{DynamicResource PrimaryButton}" Padding="18,8" Click="Apply_Click"/></StackPanel></Border>
 </Grid>
 </Border>
</Window>
