<Window x:Class="SystemPulse.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SystemPulse Changelog" Icon="pack://application:,,,/Assets/SystemPulse.ico" Width="860" Height="740" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}" ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="ChangeShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.14" Color="#000000" />
        <Style x:Key="ChangeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,13" />
            <Setter Property="Effect" Value="{StaticResource ChangeShadow}" />
        </Style>
        <Style x:Key="ChangeLine" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <Image Width="26" Height="26" Source="pack://application:,,,/Assets/SystemPulse.ico" Stretch="Uniform" SnapsToDevicePixels="True" />
                    <TextBlock Text="SystemPulse" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="Changelog" Margin="9,1,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="46" Height="51" ToolTip="Close" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Viewbox Width="12" Height="12"><Canvas Width="16" Height="16"><Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" /></Canvas></Viewbox></Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,25,30,25">
                <TextBlock Text="What’s new" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Recent SystemPulse improvements." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,5,0,20" />

                <Border Style="{StaticResource ChangeCard}" BorderBrush="#5058D6C7">
                    <StackPanel>
                        <Grid><TextBlock Text="v0.9.3" FontSize="18" FontWeight="SemiBold" /><Border HorizontalAlignment="Right" Background="#1858D6C7" CornerRadius="10" Padding="9,3"><TextBlock Text="CURRENT" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /></Border></Grid>
                        <TextBlock Text="&#x2022; Added Fan Control with automatic writable-channel and temperature-source discovery through LibreHardwareMonitor and PawnIO." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added manual, flat, linear, graph, trigger, mixed-sensor, synchronized, and automatic feedback fan modes." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added fan profiles, RPM pairing, guided calibration, graph points, hysteresis, response timing, step limits, start/stop/minimum limits, offsets, and avoid ranges." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added firmware-safe control release when control is disabled, SystemPulse closes, hardware refresh fails, or the user releases all channels." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.9.2.4" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Fixed physical-drive capacity usage by mapping mounted Windows volumes through native disk extents with modern and legacy storage-provider fallbacks." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added serial-number, model, and disk-size matching for controllers whose physical-drive identifiers do not match Windows disk numbers." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added ATA SMART reliability fallbacks for reallocated, pending, and uncorrectable sectors, command timeouts, interface errors, and predicted drive failure." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.9.2.3" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Fixed the v0.9.2.2 startup crash caused by combined Performance labels attempting to write back into read-only GPU and storage telemetry values." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added build-time validation that blocks future releases containing the same unsafe WPF telemetry-binding pattern." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Hardened monitoring refreshes, Intel/NVIDIA tuning actions, cleanup operations, and startup reporting so recoverable device or driver failures do not escape into unhandled UI exceptions." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Isolated the interface from GPU-driver render resets by moving the lightweight SystemPulse UI to stable software rendering; hardware telemetry and game monitoring remain unchanged." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Fixed four-part release handling for update status and permanently skipped releases, and added stricter AMD CPU sensor-range validation." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.9.2.2" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Added live purple capacity-usage bars and used percentages for every physical drive with mounted volumes." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added the same per-drive capacity information to the Drive Health list in Sensor Details." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added a reversible Game Mode that saves the current power plan, enables High performance and Windows Game Mode when available, and restores the exact previous settings." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Expanded Performance cards and graphs with CPU temperature, voltage and power, GPU hotspot and electrical details, frame pacing, drive temperature, capacity, and clearer history scales." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Restricted the Performance frame-application selector to verified games, excluding ordinary accelerated programs and launchers." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.9.2.1" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Suggestions now identify the specific non-system background apps consuming CPU, GPU, memory, or drive resources related to an alert." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added live per-process GPU-engine activity to distinguish GPU-accelerated background apps during gaming and rendering." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added an End task button beside each suggested app, with process-identity validation to prevent a stale alert from ending a reused PID." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Renamed the Processes action column to END PROGRAM and widened it for clearer scaling." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Fixed restoring a maximized SystemPulse window from the system tray after an update reopened it in the background." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.9.1" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Restricted Live Game Monitoring to verified video-game executables instead of every program that presents accelerated frames." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Excluded SystemPulse, ChatGPT, Discord, web browsers, launchers, overlays, media applications, and development tools from game-performance alerts." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added game verification through known game-library locations, Windows game records, and recognized game-engine runtime files." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; System and game-performance alerts now remain visible for 30 seconds after the condition clears, keeping their matched Suggestions link available." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.9" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Added live game-performance diagnosis to the monitoring card, including stutter, low-FPS, and unstable frame-pacing detection." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added automatic cause matching across CPU, GPU, GPU hotspot, memory, drive activity, drive temperature, and drive health." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added a responsive Suggestions window with fixes and in-game setting recommendations matched to the active game and detected problem." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Improved active-game naming by using application product information when it is available." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Updated SystemPulse to reopen minimized in the background after an automatic update so games and other full-screen applications keep focus." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.8.8" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Added General, Apps, and Games tabs to make the Processes page easier to browse." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added automatic detection for user-facing applications and games installed through common PC game platforms." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added an instant end-task control for each process, with a clear warning that unsaved work can be lost." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Expanded process collection so lower-activity applications and games remain available in their tabs." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.8.6" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Added permanent maximum-temperature tracking for every detected drive." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Drive temperature records now update whenever SystemPulse detects a new high and remain saved after restarts and updates." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Fixed the changelog opening too large or partly off-screen on vertical, secondary, and mixed-resolution monitors." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v0.7.0" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Added LibreHardwareMonitor motherboard, chipset, Super I/O, and embedded-controller temperature discovery with an ACPI fallback." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added automatic GitHub Release checks and one-click single-EXE updates." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added an open-folder icon to large-file review and dedicated EXE-folder cleanup after explicit approval." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v.06" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="&#x2022; Added threshold alerts, notification-area support, cooldown protection, and saved monitoring preferences." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added persistent telemetry history with configurable retention and CSV export." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added live Processes and Network pages using the existing SystemPulse card layout and icon system." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Expanded drive health with wear, remaining life, power-on hours, maximum temperature, and error counters." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added a dedicated Storage page with detailed identity, operational state, reliability, and live activity cards for every drive." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Fixed missing drive lifetime and power-on values by adding direct NVMe SMART/Health queries and expanded ATA SMART fallbacks." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v.05" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="• Added live CPU voltage and package-power telemetry through PawnIO." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Added NVIDIA GPU board-power and supported core-voltage telemetry." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="&#x2022; Added AMD Radeon temperature, load, voltage, and supported board-power telemetry through the installed display driver." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Added matching electrical metric layouts to the CPU and GPU Overview cards." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v.04" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="• Added Storage Cleanup as a beta feature that will continue to be improved." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Added a scan button for every detected fixed drive." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Temporary files can be cleaned separately, while every older non-temporary file requires a Delete or Keep decision." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Scans identify large files with no access or modification activity for six months or longer." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v.03" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="• Added selectable applications for accurate FPS and frame-time monitoring." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Improved storage dropdown scaling on the Performance page." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Live Monitoring now reports heavy CPU, GPU, temperature, and drive activity—or confirms the system is nominal." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Added this in-app changelog and visible version numbering." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Improved responsive spacing and resolution-aware changelog sizing." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v.02" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="• Added the Performance page with CPU and GPU load graphs." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Added real frame-time capture and FPS using bundled PresentMon." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Added per-drive load plus live read and write speeds." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChangeCard}">
                    <StackPanel>
                        <TextBlock Text="v.01" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="• Introduced the Metro-style Overview and Sensor details pages." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Added PawnIO CPU temperature monitoring, GPU telemetry, storage temperatures, and motherboard thermal zones." Style="{StaticResource ChangeLine}" />
                        <TextBlock Text="• Added standalone publishing, administrator startup, theme switching, and the SystemPulse icon." Style="{StaticResource ChangeLine}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
