<UserControl x:Class="SystemPulse.Controls.FanControlPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SystemPulse.ViewModels" UseLayoutRounding="True">
 <UserControl.Resources>
  <Style x:Key="FanCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
  <Style x:Key="FanLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,4"/></Style>
  <Style x:Key="FanBox" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style x:Key="FanTab" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="TabRoot" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="18,8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabRoot" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="TabRoot" Property="Background" Value="#2458D6C7"/><Setter TargetName="TabRoot" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CalibrationStatusText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Opacity" Value="1"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsCalibrating}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/><DataTrigger.EnterActions><BeginStoryboard x:Name="CalibrationRunningFlash"><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.28" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="CalibrationRunningFlash"/></DataTrigger.ExitActions></DataTrigger>
    <DataTrigger Binding="{Binding CalibrationCompleted}" Value="True"><Setter Property="Foreground" Value="#62E6A7"/><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.28" AutoReverse="True" RepeatBehavior="5x" FillBehavior="Stop"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="CalibrationStatusPanel" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="7"/>
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinWidth" Value="210"/>
   <Setter Property="MaxWidth" Value="390"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsCalibrating}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Danger}"/></DataTrigger>
    <DataTrigger Binding="{Binding CalibrationCompleted}" Value="True"><Setter Property="BorderBrush" Value="#62E6A7"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="CalibrationProgressTile" TargetType="Border">
   <Setter Property="Width" Value="48"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="Margin" Value="8,0,0,0"/>
   <Setter Property="Background" Value="#1FF2B84B"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="7"/>
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsCalibrating}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="CalibrationCardStatus" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Danger}"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><DataTrigger Binding="{Binding CalibrationState}" Value="Calibrated"><Setter Property="Foreground" Value="#62E6A7"/></DataTrigger><DataTrigger Binding="{Binding CalibrationState}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="30,25,30,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Fan Control" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="Every detected fan, live RPM, profiles, pairing, calibration, and hardware-safe curves through LibreHardwareMonitor and PawnIO." Foreground="{DynamicResource TextSecondary}" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox Content="Enable software control" IsChecked="{Binding IsEnabled}" Style="{DynamicResource HistoryToggle}" Width="190" Margin="0,0,10,0"/><Button Content="Refresh hardware" Command="{Binding RefreshCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Release all" Command="{Binding ReleaseAllCommand}" Style="{DynamicResource SecondaryButton}"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource FanCard}" Margin="30,0,30,15" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="PROFILE" Style="{StaticResource FanLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FanBox}"/><Button Grid.Column="2" Content="Save" Command="{Binding SaveProfileCommand}" Style="{DynamicResource SecondaryButton}" Margin="8,0"/><ComboBox Grid.Column="3" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ProfileName}" Style="{DynamicResource ThemedComboBox}"/><Button Grid.Column="4" Content="Load" Command="{Binding LoadProfileCommand}" Style="{DynamicResource SecondaryButton}" Margin="8,0,16,0"/>
   <Grid Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CalibrationStatusPanel}"><TextBlock Text="{Binding Status}" Style="{StaticResource CalibrationStatusText}"/></Border>
    <Border Grid.Column="1" Style="{StaticResource CalibrationProgressTile}"><TextBlock Text="{Binding CalibrationProgressText}" Foreground="{DynamicResource Warning}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </Grid>
  </Grid></Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,0,16,28">
   <Border Style="{StaticResource FanCard}" Background="#121F6F66" BorderBrush="{DynamicResource Accent}"><TextBlock Text="Safety: RPM-only fans are listed but remain firmware controlled. Writable channels change only after software control is enabled and return to firmware when released or SystemPulse closes." Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/></Border>
   <Border Style="{StaticResource FanCard}" Padding="12"><StackPanel Orientation="Horizontal"><RadioButton Content="All" Tag="All" GroupName="FanCategory" IsChecked="True" Style="{StaticResource FanTab}" Click="FanCategory_Click" ToolTip="Show every detected fan"/><RadioButton Content="Case" Tag="Case" GroupName="FanCategory" Style="{StaticResource FanTab}" Click="FanCategory_Click" ToolTip="Show case, chassis, system, pump, and other motherboard fans"/><RadioButton Content="CPU" Tag="CPU" GroupName="FanCategory" Style="{StaticResource FanTab}" Click="FanCategory_Click" ToolTip="Show processor cooling fans"/><RadioButton Content="GPU" Tag="GPU" GroupName="FanCategory" Style="{StaticResource FanTab}" Click="FanCategory_Click" ToolTip="Show graphics-card fans"/></StackPanel></Border>
   <TextBlock Text="{Binding FilterEmptyMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="13" TextAlignment="Center" Margin="0,18,14,24" TextWrapping="Wrap"/>
   <ItemsControl ItemsSource="{Binding FilteredChannels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:FanChannelViewModel}">
    <Border Style="{StaticResource FanCard}" Width="430" MinHeight="318"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="8" Background="#186EA8FE"><TextBlock Text="&#xE9CA;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Blue}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="230"/><TextBlock Text="{Binding Hardware}" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="230"/></StackPanel></StackPanel><TextBlock Text="{Binding ControlAvailability}" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LIVE RPM" Style="{StaticResource FanLabel}" Margin="0" HorizontalAlignment="Right"/><TextBlock Text="{Binding Rpm}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Current}" Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"/></StackPanel></Grid>
     <Grid Grid.Row="1" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><CheckBox Content="Use SystemPulse curve" IsChecked="{Binding IsControlled}" IsEnabled="{Binding CanControl}" Style="{DynamicResource HistoryToggle}"/><ComboBox Grid.Column="1" ItemsSource="{Binding CurveTypes}" SelectedItem="{Binding CurveType}" Style="{DynamicResource ThemedComboBox}" IsEnabled="{Binding CanControl}"/></Grid>
     <StackPanel Grid.Row="2" Margin="0,10,0,0"><Grid><TextBlock Text="SPEED TARGET" Style="{StaticResource FanLabel}" Margin="0"/><TextBlock Text="{Binding ManualPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><Slider Minimum="0" Maximum="100" Value="{Binding ManualPercent}" Style="{DynamicResource TuningSlider}" IsEnabled="{Binding CanControl}"/><TextBlock Text="{Binding Pairing}" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Configure curve" Click="ConfigureCurve_Click" IsEnabled="{Binding CanControl}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Calibrate" Command="{Binding DataContext.CalibrateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanControl}" Style="{DynamicResource SecondaryButton}"/></StackPanel>
     <TextBlock Grid.Row="4" Text="{Binding CalibrationText}" Style="{StaticResource CalibrationCardStatus}" Margin="0,10,0,0" ToolTip="{Binding CalibrationText}"/>
    </Grid></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Border Style="{StaticResource FanCard}"><StackPanel><TextBlock Text="Temperature sources" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Only temperature sensors related to fans in the selected tab are shown." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,12"/><ItemsControl ItemsSource="{Binding FilteredSensors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,8,8" MinWidth="190"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Hardware}" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding Reading}" Foreground="{DynamicResource Accent}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
